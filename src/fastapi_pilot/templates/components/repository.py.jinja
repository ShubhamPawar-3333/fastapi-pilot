class {{ class_name }}Repository:
    """Data access layer for {{ name_plural }}.

    No database configured — this is an in-memory stub.
    Replace with a real database implementation when ready.
    """

    def __init__(self) -> None:
        self._items: list[dict] = []
        self._next_id = 1

    async def get_all(self, skip: int = 0, limit: int = 100) -> list[dict]:
        """Get all {{ name_plural }} with pagination."""
        return self._items[skip : skip + limit]

    async def get_by_id(self, {{ name }}_id: int) -> dict | None:
        """Get a single {{ name }} by ID."""
        for item in self._items:
            if item["id"] == {{ name }}_id:
                return item
        return None

    async def create(self, data: dict) -> dict:
        """Create a new {{ name }}."""
        from datetime import UTC, datetime

        item = {
            "id": self._next_id,
            **data,
            "created_at": datetime.now(UTC),
            "updated_at": datetime.now(UTC),
        }
        self._next_id += 1
        self._items.append(item)
        return item

    async def update(self, {{ name }}_id: int, data: dict) -> dict | None:
        """Update an existing {{ name }}."""
        from datetime import UTC, datetime

        item = await self.get_by_id({{ name }}_id)
        if not item:
            return None
        item.update(data)
        item["updated_at"] = datetime.now(UTC)
        return item

    async def delete(self, {{ name }}_id: int) -> bool:
        """Delete a {{ name }}."""
        item = await self.get_by_id({{ name }}_id)
        if not item:
            return False
        self._items.remove(item)
        return True
