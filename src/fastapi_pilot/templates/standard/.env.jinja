# {{ project_name }} — Environment Variables
# Loaded by pydantic-settings. Never commit this file.

DEBUG=true
SECRET_KEY=change-this-in-production-please
{%- if database == "postgresql" %}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/{{ project_slug }}
{%- elif database == "sqlite" %}
DATABASE_URL=sqlite+aiosqlite:///./{{ project_slug }}.db
{%- endif %}